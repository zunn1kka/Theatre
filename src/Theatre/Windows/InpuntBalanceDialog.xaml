<Window x:Class="Theatre.Windows.InpuntBalanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Theatre.Windows"
        mc:Ignorable="d"
        Title="Пополнить баланс" Height="180" Width="300"
        Icon="/Assets/itm.png"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Введите сумму:" Style="{StaticResource InputLabelTextStyle}" Margin="0,0,0,5"/>
            <TextBox x:Name="AmountTextBox" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="80" Margin="0,0,5,0" 
                    Click="OkButton_Click" IsDefault="True" Style="{StaticResource ModernButtonStyle}" />
                <Button Content="Отмена" Width="80" Style="{StaticResource ModernButtonStyle}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
