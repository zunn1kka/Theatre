<Page x:Class="Theatre.Pages.EditSpectaclePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="800"
      Title="Редактирование спектакля">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <!-- Отступ между колонками -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <StackPanel Grid.Column="0">
                    <!-- Название спектакля -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Название спектакля:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox x:Name="NameTextBox" Style="{StaticResource BaseTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Количество актеров -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Количество актеров:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox x:Name="QuantityActorsTextBox" Style="{StaticResource BaseTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Дата премьеры -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Дата премьеры:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <DatePicker x:Name="PremiereDatePicker"
            SelectedDateFormat="Short"
            SelectedDate="{Binding PremiereDate, Mode=TwoWay}"
            DisplayDateStart="{x:Static sys:DateTime.Now}"
            xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Время показа:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox x:Name="ShowTimeTextBox" 
                 Text="{Binding ShowTime, StringFormat='HH\\:mm', UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource BaseTextBoxStyle}"/>
                        
                    </StackPanel>
                </StackPanel>

                <!-- Правая колонка -->
                <StackPanel Grid.Column="2">
                    <!-- Жанры -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Жанры:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <ListView x:Name="GenresComboBox" 
                                        SelectionMode="Multiple" 
                                        Height="100"
                                        DisplayMemberPath="Name"
                                        SelectedValuePath="Id"
                                        ItemsSource="{Binding AllGenres}"
                                 VirtualizingStackPanel.VirtualizationMode="Standard">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>

                    <!-- Количество мест -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Количество мест:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox x:Name="SeatCountTextBox" Style="{StaticResource BaseTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Цена за место -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Цена за место:" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox x:Name="SeatPriceTextBox" Style="{StaticResource BaseTextBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Блок изображения -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5"
                        Height="300" Width="400" Background="#FFF5F5F5">
                    <Image x:Name="SpectacleImage" Stretch="Uniform" Height="300" Width="500"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Content="Выбрать изображение" Margin="5" 
                                Click="SelectImageButton_Click" 
                                Style="{StaticResource ModernButtonStyle}"
                                Width="200"
                                Height="35"/>
            </StackPanel>

            <!-- Кнопки управления -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                
                <Button Content="Сохранить изменения" Margin="5" 
                        Click="SaveButton_Click" 
                        Style="{StaticResource ModernButtonStyle}"
                        Height="35"
                        Width="150"/>
                <Button Content="Отменить изменения" Margin="5" 
                        Click="CancelButton_Click" 
                        Style="{StaticResource ModernButtonStyle}"
                        Height="35"
                        Width="150"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>