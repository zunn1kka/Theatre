<Page x:Class="Theatre.Pages.SpectaclePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
      xmlns:converters="clr-namespace:Theatre.Pages.Converters"
      Title="Спектакль">
    <Page.Resources>
        <CollectionViewSource x:Key="FilteredSeats" Source="{Binding Spectacle.Seats}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="IsBooked" Direction="Ascending" />
                <scm:SortDescription PropertyName="SeatNumber" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>
    <Grid Margin="25" Background="{StaticResource LightBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок спектакля -->
        <Border Grid.Row="0" 
                Background="{StaticResource ColorPrimary}"
                CornerRadius="10" 
                Padding="25"
                Effect="{StaticResource CardShadow}"
                Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="280" Height="180" 
                        CornerRadius="6"
                        Background="{StaticResource ColorPrimaryLight}"
                        BorderBrush="{StaticResource ColorPrimaryDark}" 
                        BorderThickness="1">
                    <Image Source="{Binding Spectacle.Image}" 
                           Stretch="UniformToFill"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" 
                            Margin="25,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Spectacle.Name}" 
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextOnPrimary}"
                               TextWrapping="Wrap"
                               MaxWidth="600"
                               HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <StackPanel>
                            
                            <TextBlock Text="{Binding Spectacle.PremiereDate, StringFormat='Дата премьеры {0:dd.MM.yyyy}'}"
                                       FontSize="20"
                                       Foreground="White"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="40,0,0,0">
                            
                            <TextBlock Text="{Binding Spectacle.ShowTime, StringFormat='Время {0:HH\\:mm}'}"
                                       FontSize="20"
                                       Foreground="White"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="40,0,0,0">
                            <TextBlock Text="{Binding Spectacle.PriceInfo, StringFormat='Цена билета: {0:C}'}"
                       FontSize="20"
                       Foreground="White"
                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Легенда -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,25">
            <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                <Border Width="30" Height="30" 
                        Background="{StaticResource AvailableSeatBrush}" 
                        BorderBrush="{StaticResource ColorPrimaryDark}" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Effect="{StaticResource ButtonShadow}"/>
                <TextBlock Text="Свободно" 
                           Margin="12,0,0,0" 
                           VerticalAlignment="Center"
                           FontSize="18"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" 
                        Background="{StaticResource BookedSeatBrush}" 
                        BorderBrush="{StaticResource ColorPrimaryDark}" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Effect="{StaticResource ButtonShadow}"/>
                <TextBlock Text="Занято" 
                           Margin="12,0,0,0" 
                           VerticalAlignment="Center"
                           FontSize="18"/>
            </StackPanel>
        </StackPanel>

        <!-- Зал с местами -->
        <Border Grid.Row="2" 
                Background="{StaticResource ColorCard}"
                CornerRadius="10"
                Padding="20"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto"
                          Padding="10">
                <ItemsControl ItemsSource="{Binding Source={StaticResource FilteredSeats}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="12" 
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding SeatNumber}" 
                                    Style="{StaticResource SeatButtonStyle}"
                                    Command="{Binding DataContext.BookSeatCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Price, StringFormat='Ряд {0}, Место {1}, Цена: {2:C}'}"
                                    IsEnabled="{Binding IsBooked, Converter={StaticResource BooleanToInverseBooleanConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Кнопка возврата -->
        <Button Grid.Row="3" 
                Content="Назад" 
                Width="200" 
                Height="50"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="0,30,0,0"
                Click="BackButton_Click" 
                Style="{StaticResource LoginButtonStyle}"/>
    </Grid>
</Page>