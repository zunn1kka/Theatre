<Page x:Class="Theatre.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Theatre.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/TheaterBackground.jpg" 
               Stretch="UniformToFill" Opacity="0.9"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Grid.Column="1" 
                Background="{StaticResource ColorBackground}"
                CornerRadius="8"
                Padding="20"
                BorderBrush="{StaticResource ColorAccent}"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650">
                <StackPanel Width="350">
                    <!-- Заголовок -->
                    <TextBlock Text="Регистрация" 
                               FontSize="24"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Поля формы -->
                    <TextBlock Text="Логин:" 
                               Style="{StaticResource InputLabelTextStyle}"/>
                    <TextBox x:Name="RegLoginTextBox" 
                             Style="{StaticResource BaseTextBoxStyle}" 
                             Margin="0,5,0,15"/>

                    <TextBlock Text="E-mail:" 
                               Style="{StaticResource InputLabelTextStyle}"/>
                    <TextBox x:Name="EmailBox" 
                             Style="{StaticResource ValidatableTextBoxStyle}"
                             Text="{Binding Email, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,15"/>

                    <!-- Код подтверждения -->
                    <Grid Margin="0,5,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Код подтверждения:" 
                                       Style="{StaticResource InputLabelTextStyle}"/>
                            <TextBox x:Name="CodeTextBox" 
                                     Style="{StaticResource BaseTextBoxStyle}"/>
                        </StackPanel>

                        <Button x:Name="SendCodeBtn" 
                                Content="Отправить код" 
                                Style="{StaticResource ModernButtonStyle}" 
                                Click="SendCodeBtn_Click"
                                Grid.Column="1"
                                Margin="10,20,0,0"
                                Padding="10,5"
                                Width="120"
                                Height="35"/>
                    </Grid>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль:" 
                               Style="{StaticResource InputLabelTextStyle}"/>
                    <TextBox x:Name="RegPasswordBox" 
                             Style="{StaticResource BaseTextBoxStyle}" 
                             Margin="0,5,0,15" 
                             PreviewMouseDown="RegPasswordBox_PreviewMouseDown" TextChanged="RegPasswordBox_TextChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                        <Rectangle x:Name="pwdWeak" Fill="Gray" Width="50" Height="5" Margin="0,0,5,0"/>
                        <Rectangle x:Name="pwdMedium" Fill="Gray" Width="50" Height="5" Margin="0,0,5,0"/>
                        <Rectangle x:Name="pwdStrong" Fill="Gray" Width="50" Height="5"/>
                    </StackPanel>
                    <TextBlock x:Name="PasswordStrengthDescription" 
                                FontSize="12" 
                                Margin="0,5,0,0"
                                TextWrapping="Wrap"/>
                    <Button Content="Сгенерировать пароль" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Visibility="Collapsed" 
                            x:Name="GeneratePasswordButton" 
                            Click="GeneratePasswordButton_Click"
                            Margin="0,0,0,15"/>

                    <!-- Подтверждение пароля -->
                    <TextBlock Text="Подтвердите пароль:" 
                               Style="{StaticResource InputLabelTextStyle}"/>
                    <TextBox x:Name="RegConfirmPasswordBox" 
                             Style="{StaticResource BaseTextBoxStyle}" 
                             Margin="0,5,0,15" />

                    <!-- Кнопка регистрации -->
                    <Button Content="Зарегистрироваться" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Click="RegisterButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0"
                            Padding="15,8"/>
                    <TextBlock Margin="0,15,0,0"
           HorizontalAlignment="Center">
                        <Hyperlink Command="{Binding NavigateToAuthCommand}">
                                Уже есть аккаунт
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>